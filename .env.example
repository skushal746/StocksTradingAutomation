# Copy to .env and fill in. NEVER commit .env.

# ---- Mode -------------------------------------------------------------
# paper = simulated fills driven by live ticks (DEFAULT, safe)
# live  = real MIS orders via Kite REST API (requires LIVE_TRADING_ACK)
TRADING_MODE=paper
LIVE_TRADING_ACK=

# ---- Logging ----------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=logs

# ---- Database (PostgreSQL + asyncpg) ----------------------------------
DATABASE_URL=postgresql+asyncpg://trader:trader@localhost:5432/trading

# ---- Zerodha Kite Connect ---------------------------------------------
KITE_API_KEY=
KITE_API_SECRET=
# Generated daily via `python main.py kite-login-url` then `kite-session`
KITE_ACCESS_TOKEN=
KITE_EXCHANGE=NSE
WS_RECONNECT_MAX_TRIES=50
WS_RECONNECT_MAX_DELAY=60

# ---- LLM ----------------------------------------------------------------
LLM_PROVIDER=openai            # openai | anthropic
LLM_MODEL=                     # blank = provider default (gpt-4o-mini / claude-haiku-5-5)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_CONCURRENCY=5
LLM_TIMEOUT_SECONDS=30

# ---- News ingestion ---------------------------------------------------
# Comma-separated RSS/Atom URLs. Verify these still work before relying on them.
NEWS_FEED_URLS=https://www.moneycontrol.com/rss/MCtopnews.xml,https://economictimes.indiatimes.com/markets/rssfeeds/1977021501.cms,https://www.livemint.com/rss/markets
NEWS_REQUEST_TIMEOUT_SECONDS=10
NEWS_LOOKBACK_HOURS=18

# ---- Watchlist ----------------------------------------------------------
WATCHLIST_SIZE=5
PREMARKET_CUTOFF=08:45
WATCHLIST_ALLOW_SHORTS=false

# ---- Risk limits (fractions unless noted) -----------------------------
CAPITAL_INR=500000
MAX_DAILY_LOSS_PCT=0.02          # halt new entries once realised+unrealised PnL <= -2% of capital
STOP_LOSS_PCT=0.005              # 0.5% stop-loss from entry
TARGET_PCT=0.01                  # 1.0% take-profit from entry
RISK_PER_TRADE_PCT=0.005         # max capital risked per trade (sizes the position)
MAX_OPEN_POSITIONS=3
SEBI_PEAK_MARGIN_PCT=0.20        # intraday must hold >= 20% of notional as margin (max ~5x leverage)
MAX_MARGIN_UTILISATION=0.80      # never use more than 80% of available margin

# ---- ORB strategy -------------------------------------------------------
ORB_RANGE_MINUTES=15             # 5 or 15
ORB_VOLUME_MULTIPLIER=1.5        # last-60s volume must be >= 1.5x opening-range per-minute average
MARKET_OPEN=09:15
ENTRY_CUTOFF=14:30
SQUARE_OFF_TIME=15:10
PAPER_SLIPPAGE_PCT=0.0005
