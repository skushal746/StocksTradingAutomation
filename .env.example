# Copy to .env and fill in. NEVER commit .env.

# ---- Mode -------------------------------------------------------------
# paper = simulated fills driven by live ticks (DEFAULT, safe)
# live  = real MIS orders via Kite REST API (requires LIVE_TRADING_ACK)
TRADING_MODE=
LIVE_TRADING_ACK=

# ---- Logging ----------------------------------------------------------
LOG_LEVEL=
LOG_DIR=

# ---- Database (PostgreSQL + asyncpg) ----------------------------------
POSTGRES_PASSWORD=
DATABASE_URL=


# ---- Zerodha Kite Connect ---------------------------------------------
KITE_API_KEY=
KITE_API_SECRET=
# Generated daily via `python main.py kite-login-url` then `kite-session`
KITE_ACCESS_TOKEN=
KITE_EXCHANGE=
WS_RECONNECT_MAX_TRIES=
WS_RECONNECT_MAX_DELAY=

# ---- LLM ----------------------------------------------------------------
LLM_PROVIDER=
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_CONCURRENCY=
LLM_TIMEOUT_SECONDS=

# ---- News ingestion ---------------------------------------------------
# Comma-separated RSS/Atom URLs. Verify these still work before relying on them.
NEWS_FEED_URLS=
NEWS_REQUEST_TIMEOUT_SECONDS=
NEWS_LOOKBACK_HOURS=

# ---- NewsData.io (optional). Free plan: 200 credits/day, 1-10 articles per credit,
# ---- articles delayed ~12 hours, last 48 hours only. Leave the key blank to disable.
NEWSDATA_API_KEY=
NEWSDATA_QUERY=
NEWSDATA_COUNTRY=
NEWSDATA_LANGUAGE=
NEWSDATA_SIZE=

# ---- Watchlist ----------------------------------------------------------
WATCHLIST_SIZE=
PREMARKET_CUTOFF=
WATCHLIST_ALLOW_SHORTS=

# ---- Risk limits (fractions unless noted) -----------------------------
CAPITAL_INR=
MAX_DAILY_LOSS_PCT=
STOP_LOSS_PCT=
TARGET_PCT=
RISK_PER_TRADE_PCT=
MAX_OPEN_POSITIONS=
SEBI_PEAK_MARGIN_PCT=
MAX_MARGIN_UTILISATION=

# ---- ORB strategy -------------------------------------------------------
ORB_RANGE_MINUTES=
ORB_VOLUME_MULTIPLIER=
MARKET_OPEN=
ENTRY_CUTOFF=
SQUARE_OFF_TIME=
PAPER_SLIPPAGE_PCT=
